<Window x:Class="SaveGameCloud.Views.LaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SaveGameCloud" Height="170" Width="460" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
    <StackPanel Margin="22" VerticalAlignment="Center">
        <DockPanel>
            <Image x:Name="GameIcon" Width="40" Height="40" Margin="0,0,14,0" DockPanel.Dock="Left"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="GameName" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>
        <ProgressBar IsIndeterminate="True" Margin="0,18,0,0"/>
    </StackPanel>
</Window>
