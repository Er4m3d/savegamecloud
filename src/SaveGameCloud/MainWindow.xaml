<Window x:Class="SaveGameCloud.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SaveGameCloud" Height="620" Width="1000" MinHeight="460" MinWidth="780"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête : titre + compte Google -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="AccountName" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AccountEmail" HorizontalAlignment="Right" Style="{StaticResource Subtle}" FontSize="12"/>
                    </StackPanel>
                    <Button x:Name="ImportSecretButton" Content="Importer client_secret.json…" Click="ImportSecret_Click" Visibility="Collapsed"/>
                    <Button x:Name="SignInButton" Content="Se connecter avec Google" Style="{StaticResource AccentButton}" Click="SignIn_Click" Margin="0"/>
                    <Button x:Name="SignOutButton" Content="Se déconnecter" Click="SignOut_Click" Margin="0" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="☁" FontSize="24" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="SaveGameCloud" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Vos sauvegardes de jeux, synchronisées dans Google Drive" Style="{StaticResource Subtle}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Liste des jeux -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="10">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Content="＋  Ajouter un jeu" Style="{StaticResource AccentButton}" Margin="0,8,0,0" Click="AddGame_Click"/>
                    <TextBlock DockPanel.Dock="Top" Text="MES JEUX" Style="{StaticResource SectionTitle}" Margin="4,2,0,8"/>
                    <Grid>
                        <ListBox x:Name="GamesList" SelectionChanged="GamesList_SelectionChanged" MouseDoubleClick="GamesList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,10,0" DockPanel.Dock="Left"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="{Binding SubtitleBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyListText" Style="{StaticResource Subtle}" TextWrapping="Wrap" TextAlignment="Center"
                                   VerticalAlignment="Center" Margin="12"
                                   Text="Aucun jeu pour l'instant.&#x0a;Cliquez sur « Ajouter un jeu » et sélectionnez son exécutable."/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Détails du jeu sélectionné -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="22">
                <Grid>
                    <TextBlock x:Name="NoSelectionText" Text="Sélectionnez un jeu dans la liste." Style="{StaticResource Subtle}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <DockPanel x:Name="DetailsPanel" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Top">
                            <DockPanel>
                                <Image x:Name="DetailIcon" Width="48" Height="48" Margin="0,0,14,0" DockPanel.Dock="Left"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailName" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="DetailExe" Style="{StaticResource Subtle}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>

                            <StackPanel x:Name="ActionsPanel">
                                <WrapPanel Margin="0,18,0,0">
                                    <Button x:Name="PlayButton" Content="▶  Jouer" Style="{StaticResource AccentButton}" FontSize="15" Padding="26,9" Click="Play_Click"/>
                                    <Button Content="Modifier…" Click="EditGame_Click"/>
                                    <Button Content="Raccourci bureau" Click="Shortcut_Click" ToolTip="Crée un raccourci qui lance le jeu avec la synchronisation"/>
                                    <Button Content="Supprimer" Style="{StaticResource DangerButton}" Click="DeleteGame_Click"/>
                                </WrapPanel>

                                <TextBlock Text="SYNCHRONISATION" Style="{StaticResource SectionTitle}" Margin="0,22,0,6"/>
                                <TextBlock x:Name="DetailSync" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="⬆  Envoyer vers le cloud" Click="UploadNow_Click"/>
                                    <Button Content="⬇  Récupérer depuis le cloud" Click="DownloadNow_Click"/>
                                    <Button Content="Sauvegardes de secours" Click="OpenBackups_Click" ToolTip="Copies locales faites avant chaque téléchargement"/>
                                </WrapPanel>
                            </StackPanel>

                            <TextBlock Text="FICHIERS ET DOSSIERS SYNCHRONISÉS" Style="{StaticResource SectionTitle}" Margin="0,22,0,6"/>
                        </StackPanel>

                        <Border Background="{StaticResource PanelAltBrush}" CornerRadius="6" Padding="10">
                            <Grid>
                                <ItemsControl x:Name="DetailItems">
                                    <ItemsControl.Template>
                                        <ControlTemplate>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <TextBlock Text="{Binding Glyph}" Width="22" DockPanel.Dock="Left"/>
                                                <TextBlock Text="{Binding CloudName}" FontWeight="SemiBold" Width="170" TextTrimming="CharacterEllipsis" DockPanel.Dock="Left"/>
                                                <TextBlock Text="{Binding LocalPath}" Foreground="{Binding PathBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LocalPath}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoItemsText" Style="{StaticResource Subtle}" TextWrapping="Wrap" Visibility="Collapsed"
                                           Text="Aucun élément à synchroniser. Cliquez sur « Modifier… » pour choisir les fichiers et dossiers de sauvegarde."/>
                            </Grid>
                        </Border>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Barre d'état -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
                <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Visibility="Hidden"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Subtle}" Margin="16,6,16,8" Text="Prêt."/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
